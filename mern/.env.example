PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/apmc_yard?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
ADMIN_NAME=APMC Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_long_random_password_12_chars_minimum
# Optional
NODE_ENV=development
# debug | info | warn | error (default: debug in development, info in production)
LOG_LEVEL=info
